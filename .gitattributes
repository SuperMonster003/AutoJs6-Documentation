# Keep documentation sources and generated text byte-stable across platforms.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows command wrappers remain directly executable by cmd.exe.
*.bat text eol=crlf
