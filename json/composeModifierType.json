                  "signatures": [
                    {
                      "params": [
                        {
                          "textRaw": "**contentDescription** { [string](dataTypes#string) | [null](dataTypes#null) } ",
                          "name": "**contentDescription**",
                          "type": " [string](dataTypes#string) | [null](dataTypes#null) "
