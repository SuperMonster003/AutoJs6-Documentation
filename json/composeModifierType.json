                          "desc": "水平偏移, 可为负数."
                        },
                        {
                          "textRaw": "**y** { [ComposeDpInput](composeComponents#composedpinput) } - 垂直偏移, 可为负数. ",
                          "name": "**y**",
                          "type": " [ComposeDpInput](composeComponents#composedpinput) ",
                          "desc": "垂直偏移, 可为负数."
                        },
                        {
                          "textRaw": "<ins>**returns**</ins> { [ComposeModifier](composeModifierType) } ",
                          "name": "<ins>**returns**</ins>",
                          "type": " [ComposeModifier](composeModifierType) "
                        }
                      ]
                    },
                    {
                      "params": [
                        {
                          "name": "x"
                        },
