        {
          "textRaw": "[m] annotationsAsync",
          "name": "[m]_annotationsasync",
          "methods": [
            {
              "textRaw": "epub.annotationsAsync(path)",
              "type": "method",
              "name": "annotationsAsync",
              "desc": "<p><strong><code>6.8.0</code></strong> <strong><code>Async</code></strong></p>\n<ul>\n<li><strong>path</strong> { <a href=\"dataTypes#string\">string</a> | {{ path: <a href=\"dataTypes#string\">string</a>; displayName?: <a href=\"dataTypes#string\">string</a> }} } - 文件路径或打开选项</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Promise\">Promise</a>&lt;<a href=\"dataTypes#object\">Object</a>[]&gt; }</li>\n</ul>\n",
