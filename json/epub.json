                      "name": "path"
                    }
                  ]
                }
              ]
            },
            {
              "textRaw": "epub.cover(path, outputPath, options?)",
              "type": "method",
              "name": "cover",
              "desc": "<p><strong><code>6.8.0</code></strong> <strong><code>Overload 2/2</code></strong></p>\n<ul>\n<li><strong>path</strong> { <a href=\"dataTypes#string\">string</a> | {{ path: <a href=\"dataTypes#string\">string</a>; displayName?: <a href=\"dataTypes#string\">string</a> }} } - 文件路径或打开选项</li>\n<li><strong>outputPath</strong> { <a href=\"dataTypes#string\">string</a> } - 输出文件路径, 或已存在的目录 (以封面资源自身的文件名保存)</li>\n<li><strong>[ options ]</strong> {{ overwrite?: <a href=\"dataTypes#boolean\">boolean</a> }} - <code>overwrite</code> 默认 <code>false</code>, 目标文件已存在时抛出 <code>INVALID_ARGUMENT</code></li>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#string\">string</a> } - 已保存的文件路径</li>\n</ul>\n<p>打开书籍, 把封面资源原样保存到 <code>outputPath</code> 后关闭. 输出路径同样按脚本工作目录解析.</p>\n<pre><code class=\"lang-js\">let saved = epub.cover(&#39;./books/moby-dick.epub&#39;, &#39;./covers&#39;, { overwrite: true });\nconsole.log(saved); // ./covers/cover.jpg\n</code></pre>\n",
