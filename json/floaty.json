          ],
          "desc": "<p>确保当前应用已取得悬浮窗权限. 权限缺失时打开系统设置页面.</p>\n"
        },
        {
          "textRaw": "floaty.closeAll()",
          "type": "method",
          "name": "closeAll",
          "desc": "<p>关闭所有本脚本的悬浮窗.</p>\n",
