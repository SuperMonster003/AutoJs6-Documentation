                },
                {
                  "params": []
                }
              ],
              "desc": "<p>加载消息目录第一层的全部 <code>.json</code> 文件. 每个文件的不含扩展名部分作为区域设置标识. 此方法不会递归扫描子目录.</p>\n"
            }
          ],
          "type": "module",
          "displayName": "[m] loadAll"
        }
