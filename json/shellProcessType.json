              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] isAlive"
        },
        {
          "textRaw": "[m] readLine",
          "name": "[m]_readline",
          "methods": [
            {
              "textRaw": "proc.readLine()",
              "type": "method",
              "name": "readLine",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#string\">string</a> | <a href=\"dataTypes#null\">null</a> } - 下一行 stdout, 不含换行符; 输出结束时为 <code>null</code></li>\n</ul>\n<p>阻塞调用线程直到读到一行或输出结束. 不应在 Android UI 线程调用. 进程被结束后返回 <code>null</code>.</p>\n<pre><code class=\"lang-js\">let proc = shell.spawn(&#39;echo a; echo b&#39;);\nconsole.log(proc.readLine()); // a\nconsole.log(proc.readLine()); // b\nconsole.log(proc.readLine()); // null\n</code></pre>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] readLine"
        },
        {
          "textRaw": "[m] readErrorLine",
          "name": "[m]_readerrorline",
          "methods": [
            {
              "textRaw": "proc.readErrorLine()",
              "type": "method",
              "name": "readErrorLine",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#string\">string</a> | <a href=\"dataTypes#null\">null</a> } - 下一行 stderr, 不含换行符; 输出结束时为 <code>null</code></li>\n</ul>\n<p>与 <a href=\"#m-readline\">readLine</a> 相同, 读取 stderr. <code>pty</code> 时 stderr 已并入 stdout, 此方法立即返回 <code>null</code>.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] readErrorLine"
        },
        {
          "textRaw": "[m] write",
          "name": "[m]_write",
          "methods": [
            {
              "textRaw": "proc.write(text)",
              "type": "method",
              "name": "write",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><strong>text</strong> { <a href=\"dataTypes#string\">string</a> } - 写入 stdin 的文本</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"shellProcessType\">ShellProcess</a> } - 当前对象, 可链式调用</li>\n</ul>\n<p>写入后立即刷新. stdin 已关闭或进程已结束时抛出异常.</p>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "text"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] write"
        },
        {
          "textRaw": "[m] writeLine",
          "name": "[m]_writeline",
          "methods": [
            {
              "textRaw": "proc.writeLine(text)",
              "type": "method",
              "name": "writeLine",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><strong>text</strong> { <a href=\"dataTypes#string\">string</a> } - 写入 stdin 的文本</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"shellProcessType\">ShellProcess</a> } - 当前对象, 可链式调用</li>\n</ul>\n<p>与 <a href=\"#m-write\">write</a> 相同, 并在末尾追加换行符.</p>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "text"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] writeLine"
        },
        {
          "textRaw": "[m] closeInput",
          "name": "[m]_closeinput",
          "methods": [
            {
              "textRaw": "proc.closeInput()",
              "type": "method",
              "name": "closeInput",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"shellProcessType\">ShellProcess</a> } - 当前对象, 可链式调用</li>\n</ul>\n<p>关闭 stdin, 读取 stdin 的命令随即读到结尾.</p>\n<pre><code class=\"lang-js\">let proc = shell.spawn(&#39;cat&#39;);\nproc.writeLine(&#39;hello&#39;).closeInput();\nconsole.log(proc.readLine()); // hello\nconsole.log(proc.waitFor()); // 0\n</code></pre>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] closeInput"
        },
        {
          "textRaw": "[m] waitFor",
          "name": "[m]_waitfor",
          "methods": [
            {
              "textRaw": "proc.waitFor()",
              "type": "method",
              "name": "waitFor",
              "desc": "<p><strong><code>6.8.0</code></strong> <strong><code>Overload 1/2</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#number\">number</a> } - 退出码</li>\n</ul>\n<p>阻塞到进程退出. 不应在 Android UI 线程调用.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            },
            {
              "textRaw": "proc.waitFor(timeout)",
              "type": "method",
              "name": "waitFor",
              "desc": "<p><strong><code>6.8.0</code></strong> <strong><code>Overload 2/2</code></strong></p>\n<ul>\n<li><strong>timeout</strong> { <a href=\"dataTypes#number\">number</a> } - 最长等待时间, 单位为毫秒, 不能为负数</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#number\">number</a> | <a href=\"dataTypes#null\">null</a> } - 退出码, 到时仍在运行时为 <code>null</code></li>\n</ul>\n<pre><code class=\"lang-js\">let proc = shell.spawn(&#39;sleep 5&#39;);\nconsole.log(proc.waitFor(200)); // null\nproc.kill();\n</code></pre>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "timeout"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] waitFor"
        },
        {
          "textRaw": "[m] kill",
          "name": "[m]_kill",
          "methods": [
            {
              "textRaw": "proc.kill()",
              "type": "method",
              "name": "kill",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#boolean\">boolean</a> } - 调用时进程是否仍在运行</li>\n</ul>\n<p>结束进程及其启动的子进程, 例如 <code>getevent | grep ...</code> 中的 <code>getevent</code> 与 <code>grep</code>. Root 模式下这些进程不属于 AutoJs6, 由另一个 Root Shell 按命令中的标记结束, 因此会有短暂延迟. 已注册的监听器仍会收到剩余的行与 <code>exit</code> 事件.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] kill"
        },
        {
          "textRaw": "[m] getInputStream",
          "name": "[m]_getinputstream",
          "methods": [
            {
              "textRaw": "proc.getInputStream()",
              "type": "method",
              "name": "getInputStream",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"https://developer.android.com/reference/java/io/InputStream\">java.io.InputStream</a> } - stdout</li>\n</ul>\n<p>返回原始 stdout. 此后 stdout 不能再使用 <a href=\"#m-readline\">readLine</a> 或 <code>output</code> 事件.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] getInputStream"
        },
        {
          "textRaw": "[m] getErrorStream",
          "name": "[m]_geterrorstream",
          "methods": [
            {
              "textRaw": "proc.getErrorStream()",
              "type": "method",
              "name": "getErrorStream",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"https://developer.android.com/reference/java/io/InputStream\">java.io.InputStream</a> } - stderr</li>\n</ul>\n<p>返回原始 stderr, <code>pty</code> 时为空流. 此后 stderr 不能再使用 <a href=\"#m-readerrorline\">readErrorLine</a> 或 <code>errorOutput</code> 事件.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] getErrorStream"
        },
        {
          "textRaw": "[m] getOutputStream",
          "name": "[m]_getoutputstream",
          "methods": [
            {
              "textRaw": "proc.getOutputStream()",
              "type": "method",
              "name": "getOutputStream",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"https://developer.android.com/reference/java/io/OutputStream\">java.io.OutputStream</a> } - stdin</li>\n</ul>\n<p>返回原始 stdin, 与 <a href=\"#m-write\">write</a> 写入同一个流.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] getOutputStream"
        },
        {
          "textRaw": "[m] toString",
          "name": "[m]_tostring",
          "methods": [
            {
              "textRaw": "proc.toString()",
              "type": "method",
              "name": "toString",
              "desc": "<p><strong><code>6.8.0</code></strong></p>\n<ul>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#string\">string</a> } - 便于诊断的摘要</li>\n</ul>\n<p>包含 <code>pid</code>, <code>mode</code>, 命令行开头部分, 是否运行及退出码.</p>\n",
              "signatures": [
                {
                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m] toString"
        },
        {
          "textRaw": "事件",
          "name": "事件",
          "desc": "<p>使用 <code>on</code>, <code>addListener</code>, <code>once</code>, <code>prependListener</code>, <code>prependOnceListener</code>, <code>off</code>, <code>removeListener</code> 和 <code>removeAllListeners</code> 管理监听器, 它们返回当前对象; <code>listenerCount(eventName)</code> 返回监听器数量. 注册监听器或通过 off/removeListener 移除监听器时, 事件名只能是下表之一, 其他事件名抛出异常. TypeScript 根据事件名推断回调参数: output/errorOutput 为 string, exit 为 number. 此对象不提供 emit 或其他未列出的 EventEmitter 方法.</p>\n<table>\n<thead>\n<tr>\n<th>事件</th>\n<th>回调签名</th>\n<th>含义</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>output</td>\n<td><code>(line: string) =&gt; void</code></td>\n<td>一行 stdout, 不含换行符</td>\n</tr>\n<tr>\n<td>errorOutput</td>\n<td><code>(line: string) =&gt; void</code></td>\n<td>一行 stderr, 不含换行符</td>\n</tr>\n<tr>\n<td>exit</td>\n<td><code>(exitCode: number) =&gt; void</code></td>\n<td>进程已退出, 且以事件读取的流已排空; 每个对象交付一次</td>\n</tr>\n</tbody>\n</table>\n<p>事件经注册监听器的线程的事件循环交付, 与 <code>setTimeout</code> 相同. 存在监听器且进程运行期间, 脚本不会因主代码执行完毕而退出; 移除全部监听器后不再阻止脚本退出.</p>\n<p>第一个 <code>output</code> 或 <code>errorOutput</code> 监听器开始读取对应的流, 此后移除全部监听器时, 读到的行被丢弃. 监听器处理不及时时暂停读取而不丢弃行, 进程随后在写满的管道上阻塞. <code>exit</code> 在最后一行之后交付; 进程结束后才注册的 <code>exit</code> 监听器同样会收到.</p>\n<pre><code class=\"lang-js\">let proc = shell.spawn(&#39;for i in 1 2 3; do echo line$i; sleep 1; done; exit 5&#39;);\nproc.on(&#39;output&#39;, (line) =&gt; console.log(&#39;out:&#39;, line));\nproc.on(&#39;exit&#39;, (code) =&gt; console.log(&#39;exit:&#39;, code)); // exit: 5\n</code></pre>\n<p>需要逐行实时读取 getevent 等在管道上缓冲输出的程序时, 可启用 <code>pty</code> (参阅 <a href=\"shell#shelloptions\">ShellOptions</a>):</p>\n<pre><code class=\"lang-js\">let proc = shizuku.spawn(&#39;getevent -tl&#39;, { pty: true });\nproc.on(&#39;output&#39;, (line) =&gt; {\n    if (line.indexOf(&#39;BTN_TOUCH&#39;) &gt;= 0) console.log(line);\n});\nsetTimeout(() =&gt; proc.kill(), 30000);\n</code></pre>\n",
          "type": "module",
          "displayName": "事件"
        }
      ],
      "type": "module",
      "displayName": "ShellProcess"
    }
  ]
