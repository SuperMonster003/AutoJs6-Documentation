              "desc": "<p>创建每日任务. <code>time</code> 和 <code>date</code> 均省略时使用当前时间.</p>\n<pre><code class=\"lang-js\">let task = tasks.addDailyTask({\n    path: &quot;./daily.js&quot;,\n    time: &quot;08:30&quot;,\n});\nconsole.log(task.id);\n</code></pre>\n"
            }
          ],
          "type": "module",
          "displayName": "[m] addDailyTask"
        },
        {
          "textRaw": "[m] addWeeklyTask",
          "name": "[m]_addweeklytask",
          "methods": [
            {
              "textRaw": "addWeeklyTask(options)",
