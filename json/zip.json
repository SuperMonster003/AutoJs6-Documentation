                    },
                    {
                      "name": "options?"
                    }
                  ]
                }
              ]
            },
            {
              "textRaw": "zipDir(dirPath, options)",
              "type": "method",
              "name": "zipDir",
              "desc": "<p><strong><code>6.7.0</code></strong> <strong><code>Overload 3/3</code></strong></p>\n<ul>\n<li><strong>dirPath</strong> { <a href=\"dataTypes#string\">string</a> } - 待压缩目录路径</li>\n<li><strong>options</strong> { <a href=\"#zipoptions\">ZipOptions</a> } - 压缩选项</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"#zipfilehandle\">ZipFileHandle</a> } - 已完成目录压缩操作的 ZIP 对象</li>\n</ul>\n<p>将目录压缩为自动命名的 ZIP 文件.</p>\n<p>目标文件名为源目录名去除扩展名后添加 <code>.zip</code>, 并位于当前脚本工作目录.</p>\n",
